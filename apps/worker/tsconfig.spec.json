{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
