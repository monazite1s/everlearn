{
  "name": "@everlearn/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:migrate": "nest build && node dist/database/migrate.js up",
    "db:migrate:down": "nest build && node dist/database/migrate.js down",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.spec.json"
  },
  "dependencies": {
    "@everlearn/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "kysely": "0.29.2",
    "pg": "8.22.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  }
}
