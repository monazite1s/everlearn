{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024", "ESNext.Collection"],
    "noEmit": true,
    "paths": {
      "@everlearn/ui/*": ["./src/*"]
