# 本地基础设施端口
POSTGRES_PORT=5432
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=8333

# Web 服务端使用的 API Origin；浏览器仍请求同源 /api/v1。
API_INTERNAL_URL=http://127.0.0.1:3001

# PostgreSQL 配置
POSTGRES_DB=everlearn
POSTGRES_USER=everlearn
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://everlearn:replace-with-local-password@127.0.0.1:5432/everlearn

# Redis 配置
REDIS_PASSWORD=replace-with-local-password
REDIS_URL=redis://:replace-with-local-password@127.0.0.1:6379

# SeaweedFS S3 配置
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=local
S3_BUCKET=everlearn
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true

# 可选 OpenAI 兼容 LLM 配置组；三个字段必须同时提供或全部留空。
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# 可选搜索配置组；两个字段必须同时提供或全部留空。
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=
