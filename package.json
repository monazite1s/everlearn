{
  "name": "everlearn",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check:file-size && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:full": "pnpm check:file-size && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "check:file-size": "node scripts/check-file-size.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --check",
    "lint": "pnpm lint:comments && pnpm lint:js && pnpm lint:css",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:files": "stylelint",
    "lint:js": "eslint . --max-warnings 0",
    "lint:js:files": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @everlearn/web build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test --workers=1 --max-failures=1",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --project tsconfig.json --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.66.0",
    "vitest": "catalog:"
  }
}
